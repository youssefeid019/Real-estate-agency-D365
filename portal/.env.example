# Dataverse environment and tenant
DATAVERSE_URL=https://yesportsfacilitydev.crm4.dynamics.com
DATAVERSE_TENANT_ID=organizations

# Option A: client credentials of the Portal Integration app
# DATAVERSE_CLIENT_ID=
# DATAVERSE_CLIENT_SECRET=

# Option B: password sign-in, impersonating the Portal Integration user
DATAVERSE_USERNAME=
DATAVERSE_PASSWORD=
DATAVERSE_CALLER_ID=

# Encrypted values (enc:v1:...) are decrypted with this key; keep it outside the project
# Encrypt with: node encrypt-secret.mjs .env.local DATAVERSE_PASSWORD
# DATAVERSE_SECRET_KEY=

# Run without impersonation (only if no Portal Integration user exists)
# DATAVERSE_ALLOW_UNSCOPED=true
