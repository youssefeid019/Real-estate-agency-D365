{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ye_sharedcommondataserviceforapps_booking"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_case_no_longer_keeps_its_facility_closed": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "incident",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "statecode,ye_takesoutofservice",
              "subscriptionRequest/filterexpression": "_ye_facility_value ne null and (statecode ne 0 or ye_takesoutofservice eq false)"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "List_other_out_of_service_cases": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            },
            "parameters": {
              "entityName": "incidents",
              "$select": "incidentid",
              "$filter": "_ye_facility_value eq @{triggerOutputs()?['body/_ye_facility_value']} and statecode eq 0 and ye_takesoutofservice eq true",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "If_none_remain": {
          "type": "If",
          "runAfter": {
            "List_other_out_of_service_cases": [
              "Succeeded"
            ]
          },
          "expression": {
            "equals": [
              "@length(outputs('List_other_out_of_service_cases')?['body/value'])",
              0
            ]
          },
          "actions": {
            "Set_facility_Available": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord"
                },
                "parameters": {
                  "entityName": "ye_facilities",
                  "recordId": "@triggerOutputs()?['body/_ye_facility_value']",
                  "item/ye_availabilitystatus": 100000000
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}