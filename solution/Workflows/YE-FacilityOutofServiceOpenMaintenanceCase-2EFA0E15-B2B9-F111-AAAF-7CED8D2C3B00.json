{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ye_sharedcommondataserviceforapps_booking"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_facility_is_closed_for_maintenance": {
          "metadata": {
            "operationMetadataId": "651413fb-9e3d-43d5-bcec-a29d0c83803b"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "ye_facility",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "ye_availabilitystatus",
              "subscriptionRequest/filterexpression": "ye_availabilitystatus eq 100000001"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Get_facility_now": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "3b26d13a-88b5-4a31-a81d-7ed428fdd228"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ye_facilities",
              "recordId": "@triggerOutputs()?['body/ye_facilityid']",
              "$select": "ye_availabilitystatus"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "List_open_out_of_service_cases": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "4024f7ed-4338-4992-a65a-47d332a826fe"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "incidents",
              "$select": "incidentid",
              "$filter": "_ye_facility_value eq @{triggerOutputs()?['body/ye_facilityid']} and statecode eq 0 and ye_takesoutofservice eq true",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "If_still_closed_and_no_case_covers_it": {
          "actions": {
            "Open_maintenance_case": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "46b86056-b9c8-4506-89b1-2b2592c796dc"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "incidents",
                  "item/title": "Out of service: @{triggerOutputs()?['body/ye_name']}",
                  "item/customerid_account@odata.bind": "/accounts(0dae39ff-b1b9-f111-aaaf-7ced8d2c3b00)",
                  "item/description": "The facility was set to Under Maintenance without an open maintenance case. Record what is wrong, repair it and resolve this case to reopen the facility for bookings.",
                  "item/ownerid@odata.bind": "/teams(3e0b8962-a8b9-f111-aaaf-7ced8d49c94e)",
                  "item/prioritycode": 1,
                  "item/ye_facility@odata.bind": "/ye_facilities(@{triggerOutputs()?['body/ye_facilityid']})",
                  "item/ye_takesoutofservice": true
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Get_facility_now": [
              "Succeeded"
            ],
            "List_open_out_of_service_cases": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Get_facility_now')?['body/ye_availabilitystatus']",
                  100000001
                ]
              },
              {
                "equals": [
                  "@length(outputs('List_open_out_of_service_cases')?['body/value'])",
                  0
                ]
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "5eefa242-25da-4e23-9d34-ef03309008bf"
          },
          "type": "If"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}